generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../.github/assets/ERD.svg"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String         @id @default(uuid())
  username                String?        @unique
  name                    String
  email                   String         @unique
  password                String?
  // cpf                     String?        @unique
  // address                 Address?       @relation(fields: [addressId], references: [id])
  status                  USERSTATUS     @default(ACTIVE)
  block_reason            String?
  birth_date              String?
  created_at              DateTime       @default(now())
  phone                   String?
  usertype                USERTYPE
  orders_amount           Int            @default(0)
  image                   String         @default("https://cdn-icons-png.flaticon.com/512/74/74472.png")
  completed_orders_amount Int            @default(0)
  speciality              Speciality?    @relation(fields: [specialityId], references: [id])
  specialityId            String?
  last_online             DateTime?      @default(now())
  last_login              DateTime?
  banner                  String?        @default("https://uez-prod-images.s3.sa-east-1.amazonaws.com/defaults/defaultbanner.jpg")
  bio                     String?        @default("Usuario criado na UezCompany, somente ele mesmo pode edita-lo.")
  addressId               String?
  owner_orders            Order[]        @relation("client")
  assigned_orders         Order[]        @relation("assigned_uezer")
  chats                   Chat[]         @relation("UserChats")
  notifications           Notification[]
  rating                  Float          @default(0.0)
  RatingsReceived         Rating[]       @relation("ReceivedRatings")
  RatingsGiven            Rating[]       @relation("GivenRatings")
}

model Speciality {
  id                      String         @id @default(uuid())
  name                    String         @unique
  type                    SPECIALITYTYPE
  profession              Profession     @relation(fields: [professionId], references: [id])
  description             String         @default("Especialidade oferecido pela UezCompany")
  completed_orders_amount Int?           @default(0)
  default_tax             Float          @default(5.0)
  orders                  Order[]
  users                   User[]
  professionId            String
}

model Profession {
  id           String       @id @default(uuid())
  name         String       @unique
  specialities Speciality[]
}

model Order {
  id           String      @id @default(uuid())
  speciality   Speciality  @relation(fields: [specialityId], references: [id])
  specialityId String
  title        String
  description  String      @default("Pedido criado na UezCompany, somente um Uezer pode finaliza-lo.")
  status       ORDERSTATUS @default(OPEN)
  available    Boolean     @default(true)
  created_at   DateTime    @default(now())
  end_date     DateTime?
  value        Float       @default(0.0)
  images       String[]
  rated        Boolean     @default(false)
  Portfolio    Portfolio[]
  Messages     Message[]
  client       User        @relation("client", fields: [clientId], references: [id])
  clientId     String
  uezer        User?       @relation("assigned_uezer", fields: [uezerId], references: [id])
  uezerId      String?
  rating       Rating? // relacao de um pra um com a tabela Rating
}

model Portfolio {
  id      String @id @default(uuid())
  order   Order  @relation(fields: [orderId], references: [id])
  orderId String
}

model Rating {
  id String @id @default(uuid())

  satisfaction Float @default(0.0)
  speed        Float @default(0.0)
  execution    Float @default(0.0)
  average      Float @default(0.0)

  feedback String @default("Avaliação feita na UezCompany, somente o cliente e o Uezer podem ver.")

  created_at DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade) // relacao de um pra um com a tabela Rating
  orderId String @unique // relacao de um pra um com a tabela Rating

  user        User   @relation("GivenRatings", fields: [userId], references: [id], onDelete: Cascade) // Quem fez a avaliação
  userId      String
  recipient   User   @relation("ReceivedRatings", fields: [recipientId], references: [id], onDelete: Cascade) // Quem recebeu a avaliação
  recipientId String
}

model Notification {
  id         String   @id @default(uuid())
  receiver   User     @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  type       String
  content    String
  created_at DateTime @default(now())
  readed     Boolean  @default(false)
  receiverId String
}

model Chat {
  id         String    @id @default(uuid())
  users      User[]    @relation("UserChats")
  messages   Message[]
  created_at DateTime  @default(now())
}

model Message {
  id         String      @id @default(uuid())
  type       MESSAGETYPE @default(TEXT)
  content    String
  created_at DateTime    @default(now())
  readed     Boolean     @default(false)
  senderId   String
  receiverId String
  chat       Chat        @relation(fields: [chatId], references: [id])
  chatId     String
  order      Order?      @relation(fields: [orderId], references: [id])
  orderId    String?
}

enum USERSTATUS {
  ACTIVE
  INACTIVE
  BLOCKED
  INCOMPLETE // Usuario que ainda nao completou o cadastro
}

enum USERTYPE {
  UEZER
  CLIENT
  BOTH
}

enum SPECIALITYTYPE {
  ONLINE
}

enum MESSAGETYPE {
  TEXT
  BUDGET
  IMAGE
  FILE
}

enum ORDERSTATUS {
  OPEN
  CANCELLED
  IN_PROGRESS
  WAITING_EVALUATION
  COMPLETED
}
